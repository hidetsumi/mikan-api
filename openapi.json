{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [
          {
            "name": "user-agent",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed."
          },
          "401": {
            "description": "Unknown email or wrong password."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed, or the email is already taken."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [
          {
            "name": "user-agent",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "401": {
            "description": "Missing, expired, revoked or already-used token."
          }
        },
        "security": [
          {
            "refresh_token": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/todo": {
      "get": {
        "operationId": "TodoController_findAll",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "COMPLETED",
                "IN_PROGRESS",
                "ON_HOLD",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedTodoResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed."
          },
          "401": {
            "description": "Missing or invalid access_token cookie."
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "todo"
        ]
      },
      "post": {
        "operationId": "TodoController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTodoDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed."
          },
          "401": {
            "description": "Missing or invalid access_token cookie."
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "todo"
        ]
      }
    },
    "/todo/{id}": {
      "patch": {
        "operationId": "TodoController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTodoDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed, or the id is not a valid UUID."
          },
          "401": {
            "description": "Missing or invalid access_token cookie."
          },
          "404": {
            "description": "No such todo, or it belongs to another user."
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "todo"
        ]
      },
      "get": {
        "operationId": "TodoController_findById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "The id is not a valid UUID."
          },
          "401": {
            "description": "Missing or invalid access_token cookie."
          },
          "404": {
            "description": "No such todo, or it belongs to another user."
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "todo"
        ]
      },
      "delete": {
        "operationId": "TodoController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "The id is not a valid UUID."
          },
          "401": {
            "description": "Missing or invalid access_token cookie."
          },
          "404": {
            "description": "No such todo, or it belongs to another user."
          }
        },
        "security": [
          {
            "access_token": []
          }
        ],
        "tags": [
          "todo"
        ]
      }
    }
  },
  "info": {
    "title": "Mikan API",
    "description": "REST API for Mikan, a todo application. Authentication uses httpOnly cookies: POST /auth/login sets `access_token` and `refresh_token`, and protected endpoints read the access token from the cookie rather than from an Authorization header.",
    "version": "0.3.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness"
    },
    {
      "name": "auth",
      "description": "Registration, login and refresh token rotation"
    },
    {
      "name": "todo",
      "description": "Todo CRUD, scoped to the authenticated user"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access_token": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token",
        "description": "JWT access token, set as an httpOnly cookie by POST /auth/login."
      },
      "refresh_token": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token",
        "description": "JWT refresh token, set as an httpOnly cookie and rotated on every use."
      }
    },
    "schemas": {
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "last_name"
        ]
      },
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "last_name": {
            "type": "string",
            "minLength": 2
          }
        },
        "required": [
          "email",
          "password",
          "name",
          "last_name"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "last_name"
        ]
      },
      "TodoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "enum": [
              "PENDING",
              "COMPLETED",
              "IN_PROGRESS",
              "ON_HOLD",
              "CANCELLED"
            ],
            "type": "string"
          },
          "priority": {
            "type": "number"
          },
          "owner_user_id": {
            "type": "string",
            "nullable": true
          },
          "room_id": {
            "type": "string",
            "nullable": true
          },
          "owner_guest_id": {
            "type": "string",
            "nullable": true
          },
          "assigned_user_id": {
            "type": "string",
            "nullable": true
          },
          "due_at": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "completed_at": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "status",
          "priority",
          "owner_user_id",
          "room_id",
          "owner_guest_id",
          "assigned_user_id",
          "due_at",
          "completed_at",
          "created_at",
          "updated_at"
        ]
      },
      "PaginatedTodoResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TodoResponseDto"
            }
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "data",
          "total"
        ]
      },
      "CreateTodoDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETED",
              "IN_PROGRESS",
              "ON_HOLD",
              "CANCELLED"
            ]
          },
          "assigned_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "priority": {
            "type": "number",
            "minimum": 0
          },
          "due_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateTodoDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETED",
              "IN_PROGRESS",
              "ON_HOLD",
              "CANCELLED"
            ]
          },
          "assigned_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "priority": {
            "type": "number",
            "minimum": 0
          },
          "due_at": {
            "format": "date-time",
            "type": "string"
          }
        }
      }
    }
  }
}
