enum TodoStatus {
  PENDING
  COMPLETED
  IN_PROGRESS
  ON_HOLD
  CANCELLED

  @@map("todo_status")
}

model Todo {
  id                 String     @id @default(uuid())
  title              String
  description        String?
  status             TodoStatus @default(PENDING)
  priority           Int
  owner_user_id      String?
  room_id            String?
  created_by_user_id String?
  created_by_guest_id String?
  assigned_user_id   String?
  due_at             DateTime?
  completed_at       DateTime?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  owner_user      User? @relation("TodoOwner", fields: [owner_user_id], references: [id])
  created_by_user User? @relation("TodoCreatedBy", fields: [created_by_user_id], references: [id])
  assigned_user   User? @relation("TodoAssignedTo", fields: [assigned_user_id], references: [id])

  @@index([owner_user_id])
  @@index([room_id])
  @@index([status])
  @@index([created_at])
  @@index([due_at])
  @@index([room_id, status, created_at])
  @@index([owner_user_id, status, created_at])
  @@map("todo")
}
