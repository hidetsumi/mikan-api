model RefreshToken {
  id                   String    @id @default(uuid())
  user_id              String
  token_hash           String
  family               String
  issued_at            DateTime  @default(now())
  expires_at           DateTime
  revoked_at           DateTime?
  replaced_by_token_id String?
  ip_address           String
  user_agent           String
  created_at           DateTime  @default(now())
  user                 User      @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("refresh_token")
}
