model RefreshToken {
  id                   String        @id @default(uuid())
  user_id              String
  token_hash           String        @unique
  family               String
  issued_at            DateTime      @default(now())
  expires_at           DateTime
  revoked_at           DateTime?
  replaced_by_token_id String?       @unique
  ip_address           String
  user_agent           String
  created_at           DateTime      @default(now())
  user                 User          @relation(fields: [user_id], references: [id])
  replaced_by          RefreshToken? @relation("TokenRotation", fields: [replaced_by_token_id], references: [id])
  replaces             RefreshToken? @relation("TokenRotation")

  @@index([user_id])
  @@index([family])
  @@index([expires_at])
  @@map("refresh_token")
}
