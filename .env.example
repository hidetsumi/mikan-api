# Database
POSTGRES_USER=mikan
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mikan_dev
DB_PORT=5432

# Prisma
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${POSTGRES_DB}

# App
PORT=3000
NODE_ENV=development

# Swagger
# The docs are served at /docs (JSON at /docs-json) outside production.
# In production they stay off unless this is explicitly set to true.
SWAGGER_ENABLED=false

# JWT
JWT_ACCESS_SECRET=super-secret-access-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-change-in-production
# JWT_ACCESS_EXPIRES_IN and JWT_REFRESH_EXPIRES_IN are hardcoded in env.ts (900s / 604800s)
